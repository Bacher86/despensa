{
  "id": "./",
  "name": "Kai",
  "short_name": "Kai",
  "description": "Con lo que hay, ¿alcanza? Kai te dice qué hay en casa, qué cocinar con eso y qué falta comprar.",
  "lang": "es-AR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2f3ec",
  "theme_color": "#f2f3ec",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "link",
      "files": [
        {
          "name": "foto",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Escanear ticket",
      "short_name": "Ticket",
      "description": "Sacale una foto al ticket del súper",
      "url": "./?accion=ticket",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dictar",
      "short_name": "Dictar",
      "description": "Decí lo que compraste o lo que se terminó",
      "url": "./?accion=voz",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Se terminó algo",
      "short_name": "Se terminó",
      "description": "Avisá qué se terminó y va a la lista",
      "url": "./?accion=termino",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lista del súper",
      "short_name": "Lista",
      "url": "./?tab=lista",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}